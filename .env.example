# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control — it is listed in .gitignore.

# IBM watsonx.ai credentials
# API key: https://cloud.ibm.com/iam/apikeys → Create
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# Project ID: dataplatform.cloud.ibm.com → your project → Manage → General
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# watsonx.ai endpoint — change region if needed:
#   us-south  → https://us-south.ml.cloud.ibm.com
#   eu-de     → https://eu-de.ml.cloud.ibm.com
#   eu-gb     → https://eu-gb.ml.cloud.ibm.com
#   jp-tok    → https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
